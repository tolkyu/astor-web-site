{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "crons": [
    { "path": "/api/jobs/retry", "schedule": "0 7 * * *" },
    { "path": "/api/jobs/daily-report", "schedule": "0 17 * * *" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{server/templates,content}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/index.html", "destination": "/api/index" },
    { "source": "/admin", "destination": "/api/index" },
    { "source": "/admin.html", "destination": "/api/index" },
    { "source": "/request", "destination": "/api/index" },
    { "source": "/api/:path*", "destination": "/api/index" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
    ]}
  ]
}
