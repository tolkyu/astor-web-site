    "tg:webhook": "node server/scripts/webhook.js",
    "admin:hash": "node server/scripts/admin-hash.js",
    "chat": "node server/scripts/chat.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
