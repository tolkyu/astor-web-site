{
  "name": "astor-web-site",
  "version": "1.0.0",
  "private": true,
  "description": "Лендінг автосервісу «Астор» + бекенд для заявок у Telegram",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "start": "node server/server.js",
