# ─── Telegram ────────────────────────────────────────────────────────────
# Токен від @BotFather. Виглядає так: 8123456789:AAH_x1Yq...
TELEGRAM_BOT_TOKEN=

# Куди слати заявки. Це може бути:
#   - ваш особистий id (число, напр. 412345678)
#   - id групи (від'ємне число, напр. -1002345678901)
# Як дізнатись — див. README-BACKEND.md, крок 3.
TELEGRAM_CHAT_ID=

# Необов'язково: id теми, якщо в групі увімкнені Topics.
# TELEGRAM_THREAD_ID=

# Приймач команд бота (/start, /help, /id, /ping) через long polling.
# За замовчуванням вимкнений. BOT_POLLING=1 вмикає його на постійному сервері.
# Не вмикайте для того самого бота, який використовує production webhook.
# ВАЖЛИВО: читати оновлення може лише ОДИН процес. Якщо запускаєте кілька
# інстансів — лишіть polling увімкненим тільки на одному, решті: BOT_POLLING=0
# BOT_POLLING=0

# Секрет для webhook. ОБОВ'ЯЗКОВИЙ на Vercel: без нього будь-хто, знаючи
# адресу, зможе слати боту фальшиві команди. Згенеруйте випадковий рядок:
#   node -e "console.log(crypto.randomUUID())"
# TELEGRAM_WEBHOOK_SECRET=
# CRON_SECRET=                  # випадковий секрет для автоматичного повтору на Vercel

# ─── Сховище (Vercel / production) ───────────────────────────────────────
# Redis для rate limit і резервних копій заявок. У serverless обов'язковий:
# пам'ять функції вмирає разом із запитом, а файлова система лише для читання.
# Ці змінні Vercel підставляє САМ, коли ви під'єднуєте Upstash for Redis
# через Storage → Marketplace. Вручну задавати не треба.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# або, якщо Upstash напряму:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── Сервер ──────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Увімкніть, якщо сервер стоїть за nginx / Caddy / Render / Fly.
# Без цього rate limit рахуватиме всіх відвідувачів як один IP.
# TRUST_PROXY=1

# ─── Захист від спаму ────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_BOOKINGS=5
RATE_LIMIT_MAX_LEADS=30

# ─── Адмінка (/admin — редагування цін) ──────────────────────────────────
# Хеш пароля. Згенерувати:  npm run admin:hash -- "ваш-пароль"
# Сам пароль нікуди не записуйте — з хеша його відновити неможливо.
# ADMIN_PASSWORD_HASH=

# Відкритий пароль замість хеша — приймається, але гірше: його бачить
# кожен, хто має доступ до панелі хостингу. Тільки для локальних тестів.
# ADMIN_PASSWORD=

# Ключ підпису сесій. Якщо не задати — виводиться з пароля, тобто зміна
# пароля автоматично розлогінює всі відкриті сесії.
# ADMIN_SESSION_SECRET=

# ─── Інше ────────────────────────────────────────────────────────────────
# Постійні приватні файли для одного локального/VPS-процесу.
# PRICE_PATH=./data/prices.json
# BOOKING_DIR=./data/bookings

# Якщо фронтенд хоститься окремо — дозволені джерела публічного API (не адмінки).
# CORS_ORIGIN=https://astor.example.com

# Дозволити старт без токена (заявки друкуються в консоль).
# У NODE_ENV=production ігнорується.
# ALLOW_DRY_RUN=1

# ─── AI-агент (чат на сайті + діалог у Telegram) ─────────────────────────
# Ключ Claude API з увімкненим білінгом: https://console.anthropic.com
# Без цього ключа агент просто вимкнений — сайт, форма заявки і бот
# працюють як раніше, у чаті з'являється телефон майстерні.
ANTHROPIC_API_KEY=
# Модель. За замовчуванням claude-sonnet-5 — баланс ціни і якості
# для діалогу, як і обирав план.
# ANTHROPIC_MODEL=claude-sonnet-5
# Глибина міркування: low (типово) / medium / high. Вище — розумніше,
# але дорожче й повільніше, а клієнт у чаті чекає відповідь.
# ANTHROPIC_EFFORT=low
# Ліміт довжини однієї відповіді. Агент має писати коротко.
# ANTHROPIC_MAX_TOKENS=2048
# Скільки разів модель може викликати інструменти на одне повідомлення.
# AGENT_MAX_ITERATIONS=8
# Скільки останніх повідомлень тримати в контексті діалогу.
# AGENT_HISTORY_LIMIT=30
# Попередження в лог, якщо один діалог спалив більше токенів.
# AGENT_TOKEN_ALERT=50000

# Ліміти чату на сайті. За кожним повідомленням стоїть платний запит до
# Claude, тож ці числа бережуть рахунок, а не лише сервер.
# RATE_LIMIT_MAX_CHAT=20              # повідомлень на сесію
# RATE_LIMIT_CHAT_WINDOW_MS=600000    # за 10 хвилин
# RATE_LIMIT_MAX_CHAT_IP=200          # повідомлень з IP за годину

# Підпис токенів сесії віджета. Якщо не задати — виводиться з
# TELEGRAM_BOT_TOKEN; у браузер секрет не потрапляє в жодному разі.
# WEB_WIDGET_SECRET=
# Потрібен ЛИШЕ якщо віджет підключають з іншого домену, ніж цей сервіс.
# Для astor.business, що віддається звідси, лишіть порожнім.
# WEB_WIDGET_ORIGIN=https://astor.business

# ─── Відгук у Google ─────────────────────────────────────────────────────
# Після оцінки 4–5 бот пропонує залишити відгук і дає кнопку-посилання.
# Одному клієнту — не частіше ніж раз на 90 днів.
#
# Якщо не задати, кнопки просто не буде: неправильна адреса відправить
# клієнта писати відгук не тій майстерні, а вгадати її неможливо.
#
# Де взяти: Google Business Profile → «Попросити відгуки», або
# https://search.google.com/local/writereview?placeid=<PLACE_ID>
GOOGLE_REVIEW_URL=https://search.google.com/local/writereview?placeid=ChIJgVSIMoPf2kARNy5dHPdVCcg

# ─── Нагадування про планове ТО ──────────────────────────────────────────
# Окремих змінних не потребує. Інтервали — у content/business.json
# (service_interval_months: 6, service_interval_km: 10000).
#
# Крон /api/jobs/service-reminders захищений тим самим CRON_SECRET, що й
# щоденний звіт. Обидва слоти крона на Vercel Hobby зайняті саме ними,
# тому в /api/jobs/retry крона немає — повтор доставки запускається
# вручну в адмінці. Див. README-BACKEND.md, розділ «Крони».
